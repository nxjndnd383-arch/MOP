-- ═══════════════════════════════════════════════
local function log(...)
    if CONFIG.Debug then
        print("[AUTO]", ...)
    end
end

local function getPlayerFarm()
    local farmFolder = Workspace:FindFirstChild("Farm")
    if not farmFolder then return nil end
    for _, farm in ipairs(farmFolder:GetChildren()) do
        if farm:GetAttribute("OwnerId") == LocalPlayer.UserId then
            return farm
        end
    end
    return nil
end

local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return char, hrp
end

local function getHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function getInventory()
    local json = LocalPlayer:GetAttribute("Inventory_JSON") or "{}"
    local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
    return (ok and type(data) == "table") and data or {}
end

local function getMoney()
    local bn = LocalPlayer:GetAttribute("Money_BN")
    if bn then return bn end
    return tostring(LocalPlayer:GetAttribute("Money") or 0)
end

local function getMoneyNumber()
    if BigMoney then
        return BigMoney.toNumber(getMoney())
    end
    return tonumber(getMoney()) or 0
end

local function distance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

-- Teleport เบาๆ (ไม่ผ่าน anti-cheat)
local function teleportTo(targetPos)
    local char, hrp = getCharacter()
    if not char or not hrp then return end
    
    -- ใช้ CFrame โดยตรง (เบาๆ)
    hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
end

-- เดินไปหา
local function walkTo(targetPos)
    local humanoid = getHumanoid()
    if humanoid then
        humanoid:MoveTo(targetPos)
    end
end

