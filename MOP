-- ระบบ 1: AUTO WATER + COLLECT
-- ═══════════════════════════════════════════════
local function findWateringCan()
    local char = LocalPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChild("Watering Can")
    if tool then return tool end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        tool = backpack:FindFirstChild("Watering Can")
        if tool then
            tool.Parent = char
            return tool
        end
    end
    return nil
end

local function getWateringCanStatus(tool)
    if not tool then return 0, 100 end
    return tool:GetAttribute("WaterAmount") or 0, tool:GetAttribute("MaxWater") or 100
end

local function findGrassNodes(farm)
    local list = {}
    for _, node in ipairs(CollectionService:GetTagged("GrassNode")) do
        if node:IsA("Attachment") and node:IsDescendantOf(farm) then
            table.insert(list, {
                node = node,
                pos = node.WorldPosition,
                growth = node:GetAttribute("GrowthLevel") or 0,
            })
        end
    end
    return list
end

local function autoWaterLoop()
    task.spawn(function()
        log("💧 Auto Water started")
        while CONFIG.AutoWater and _G.AUTO_FARM_LOADED do
            task.wait(CONFIG.WaterCooldown)
            
            local farm = getPlayerFarm()
            local char, hrp = getCharacter()
            if not farm or not hrp then continue end
            
            local tool = findWateringCan()
            if not tool then continue end
            
            local waterAmount, maxWater = getWateringCanStatus(tool)
            
            -- ถ้าน้ำหมด ให้ไปเติมที่ Sumur
            if waterAmount <= 0 then
                local well = farm:FindFirstChild("ActiveWell")
                if well then
                    local waterClaim = well:FindFirstChild("WaterClaim", true)
                    if waterClaim and distance(hrp.Position, waterClaim.Position) > 6 then
                        walkTo(waterClaim.Position)
                    end
                end
                continue
            end
            
            -- หาหญ้าที่ต้องรด (ใกล้ที่สุด)
            local nodes = findGrassNodes(farm)
            local target = nil
            local targetDist = math.huge
            for _, n in ipairs(nodes) do
                if n.growth < 100 then
                    local d = distance(hrp.Position, n.pos)
                    if d < targetDist and d <= CONFIG.WaterRange then
                        target = n
                        targetDist = d
                    end
                end
            end
            
            if target then
                -- เดินไปถ้าไกล
                if targetDist > 8 then
                    walkTo(target.pos)
                else
                    -- อยู่ในระยะ: activate tool
                    pcall(function()
                        tool:Activate()
                        task.wait(0.4)
                        tool:Deactivate()
                    end)
                end
            end
        end
        log("💧 Auto Water stopped")
    end)
end

-- ═══════════════════════════════════════════════
-- ระบบ 2: AUTO COLLECT PRODUCT
-- ═══════════════════════════════════════════════
local function autoCollectLoop()
    task.spawn(function()
        log("📦 Auto Collect started")
        while CONFIG.AutoCollect and _G.AUTO_FARM_LOADED do
            task.wait(CONFIG.CollectCooldown)
            
            local farm = getPlayerFarm()
            local char, hrp = getCharacter()
            if not farm or not hrp then continue end
            
            -- หา products ทั้งหมด
            local nearest = nil
            local nearestDist = math.huge
            
            for _, obj in ipairs(CollectionService:GetTagged("FarmProduct")) do
                if not obj.Parent or not obj:IsDescendantOf(farm) then continue end
                
                local basePart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if not basePart then continue end
                
                local d = distance(hrp.Position, basePart.Position)
                if d < nearestDist then
                    nearest = {
                        obj = obj,
                        part = basePart,
                        pos = basePart.Position,
                    }
                    nearestDist = d
                end
            end
            
            if nearest then
                if nearestDist > CONFIG.CollectRange then
                    walkTo(nearest.pos)
                else
                    -- ใช้ proximity prompt
                    local prompt = nearest.obj:FindFirstChild("ProductPrompt", true)
                    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        pcall(function()
                            prompt:InputHoldBegin()
                            task.wait(0.05)
                            prompt:InputHoldEnd()
                        end)
                    end
                end
            end
        end
        log("📦 Auto Collect stopped")
    end)
end

-- ═══════════════════════════════════════════════
-- ระบบ 3: AUTO DELIVERY
-- ═══════════════════════════════════════════════
local function buildDeliveryCart()
    local inv = getInventory()
    local cart = {}
    if not DeliveryConfig or not DeliveryConfig.Items then return cart end
    
    for name, count in pairs(inv) do
        if type(count) == "number" and count > 0 and DeliveryConfig.Items[name] then
            cart[name] = count
        end
    end
    return cart
end

local function isInventoryFull()
    local inv = getInventory()
    local total = 0
    for _, c in pairs(inv) do
        total = total + (tonumber(c) or 0)
    end
    
    local farmLevel = LocalPlayer:GetAttribute("FarmLevel") or 1
    local maxCap = 20
    if BarnConfig and BarnConfig[farmLevel] then
        maxCap = BarnConfig[farmLevel].MaxInventoryCapacity or 20
    end
    
    local mult = 1
    mult = mult + (LocalPlayer:GetAttribute("ExtraStorage_Level") or 0) * 0.03
    mult = mult + (LocalPlayer:GetAttribute("StorageExpansion_Level") or 0) * 0.04
    
    if LocalPlayer:GetAttribute("IsBackpackSuper") == true then
        mult = mult * 1.5
    end
    
    if PetSkillConfig then
        local pet = PetSkillConfig.getPlayerStatBonus(LocalPlayer, "BackpackCapacity")
        if pet and pet > 0 then mult = mult + pet / 100 end
    end
    
    local realMax = math.floor(maxCap * mult)
    return (total / realMax) >= CONFIG.DeliveryThreshold
end

local function autoDeliveryLoop()
    task.spawn(function()
        log("🚚 Auto Delivery started")
        while CONFIG.AutoDelivery and _G.AUTO_FARM_LOADED do
            task.wait(CONFIG.DeliveryCooldown)
            
            if LocalPlayer:GetAttribute("IsDelivering") == true then continue end
            if not RequestSendDelivery then continue end
            
            if isInventoryFull() then
                local cart = buildDeliveryCart()
                if next(cart) then
                    log("🚚 Sending delivery...")
                    local ok = pcall(function()
                        RequestSendDelivery:InvokeServer(cart)
                    end)
                    if ok then
                        log("✅ Delivery sent")
                    end
                end
            end
        end
        log("🚚 Auto Delivery stopped")
    end)
end

-- ═══════════════════════════════════════════════
-- ระบบ 4: AUTO BUY ANIMAL
-- ═══════════════════════════════════════════════
local function getCurrentAnimalCapacity()
    local farmLevel = LocalPlayer:GetAttribute("FarmLevel") or 1
    local maxCap = 5
    if BarnConfig and BarnConfig[farmLevel] then
        maxCap = BarnConfig[farmLevel].MaxAnimalCapacity or 5
    end
    
    local extra = LocalPlayer:GetAttribute("ExtraAnimal_Level") or 0
    maxCap = math.floor(maxCap * (1 + extra * 0.03))
    
    -- นับ capacity ที่ใช้ไป
    local used = 0
    local activeJson = LocalPlayer:GetAttribute("ActiveAnimals_JSON") or "{}"
    local ok, data = pcall(HttpService.JSONDecode, HttpService, activeJson)
    if ok and type(data) == "table" and AnimalConfig then
        for name, count in pairs(data) do
            local cfg = AnimalConfig[name]
            if cfg and cfg.CapacityCost then
                used = used + cfg.CapacityCost * count
            end
        end
    end
    
    return used, maxCap
end

local function autoBuyAnimalLoop()
    task.spawn(function()
        log("🐔 Auto Buy Animal started")
        while CONFIG.AutoBuyAnimal and _G.AUTO_FARM_LOADED do
            task.wait(CONFIG.BuyCooldown)
            
            if not RequestBuyAnimal or not AnimalConfig then continue end
            if getMoneyNumber() <= CONFIG.MinMoneyReserve then continue end
            
            local used, maxCap = getCurrentAnimalCapacity()
            if used >= maxCap then continue end
            
            for _, animalName in ipairs(CONFIG.BuyAnimalList) do
                local cfg = AnimalConfig[animalName]
                if not cfg then continue end
                
                local price = cfg.Price or 0
                local rebirthCount = LocalPlayer:GetAttribute("RebirthCount") or 0
                local mult = RebirthConfig and RebirthConfig.GetPriceMultiplier(rebirthCount) or 1
                local finalPrice = price * mult
                
                local smartShopper = LocalPlayer:GetAttribute("SmartShopper_Level") or 0
                finalPrice = finalPrice * (1 - smartShopper * 0.05)
                
                if getMoneyNumber() - finalPrice > CONFIG.MinMoneyReserve then
                    local ok = pcall(function()
                        RequestBuyAnimal:InvokeServer(animalName)
                    end)
                    if ok then
                        log("🐔 Bought", animalName)
                        task.wait(0.5)
                    end
                    break
                end
            end
        end
        log("🐔 Auto Buy Animal stopped")
    end)
end

