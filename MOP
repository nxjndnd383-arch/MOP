-- ระบบ 5: AUTO FACTORY
-- ═══════════════════════════════════════════════
local function getUnlockedFactories()
    local json = LocalPlayer:GetAttribute("UnlockedFactories_JSON") or "{}"
    local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
    if not ok or type(data) ~= "table" then return {} end
    local list = {}
    for name, unlocked in pairs(data) do
        if unlocked == true then table.insert(list, name) end
    end
    return list
end

local function autoFactoryLoop()
    task.spawn(function()
        log("🏭 Auto Factory started")
        while CONFIG.AutoFactory and _G.AUTO_FARM_LOADED do
            task.wait(CONFIG.FactoryCooldown)
            
            local factories = getUnlockedFactories()
            if #factories == 0 then continue end
            
            local inv = getInventory()
            
            for _, factoryName in ipairs(factories) do
                -- Auto Claim
                if CONFIG.AutoClaimProduction and RequestClaimProduction then
                    local ready = LocalPlayer:GetAttribute(factoryName .. "_ReadyOutput")
                    if ready and ready > 0 then
                        pcall(function()
                            RequestClaimProduction:InvokeServer(factoryName)
                        end)
                    end
                end
                
                -- Auto Start
                if CONFIG.AutoStartProduction and RequestStartProduction and FactoryConfig then
                    local cfg = FactoryConfig[factoryName]
                    if cfg and cfg.InputName then
                        -- ลองทุกระดับ tier
                        for _, tier in ipairs({"", " Emas", " Sakura", " Cosmic"}) do
                            local inputName = cfg.InputName .. tier
                            if (inv[inputName] or 0) > 0 then
                                pcall(function()
                                    RequestStartProduction:InvokeServer(factoryName, inputName)
                                end)
                                break
                            end
                        end
                    end
                end
            end
        end
        log("🏭 Auto Factory stopped")
    end)
end

